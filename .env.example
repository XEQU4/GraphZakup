# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-generated-secret
DB_PASSWORD=replace-with-your-own-database-password
DB_NAME=suppliergraph
DB_USER=suppliergraph
# DB_HOST/DB_PORT are for local Python; Compose always uses db:5432.
DB_HOST=localhost
DB_PORT=5432
# For new Compose installations. Preserve the existing name when retaining volumes.
COMPOSE_PROJECT_NAME=iz2
# Optional services in the single Compose file: local-ai OR local-ai-gpu, and https.
# prepare_deploy.py writes profiles and their matching settings together.
COMPOSE_PROFILES=
CELERY_BROKER_URL=redis://localhost:6379/0
# Native development may leave this blank; Compose always uses its private Redis DB 1.
# Public authentication must use a shared Redis limiter, never a process-local cache.
AUTH_THROTTLE_REDIS_URL=
AUTH_THROTTLE_KEY_PREFIX=iz2:auth:v1
# Trust only the actual edge proxy peer. --domain configures its single /32 address.
AUTH_TRUSTED_PROXY_CIDRS=

DJANGO_DEBUG=false
# Local Python file logs; Compose always sends logs only to stdout/stderr.
GPG_LOG_TO_FILES=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Compose intentionally binds its diagnostic web endpoint to 127.0.0.1 only.
WEB_PORT=8000
PORT=8000

# Local HTTP. Enable secure cookies and redirect with a trusted HTTPS proxy.
TRUST_PROXY_SSL_HEADER=false
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Optional https profile, after DNS is configured. No CDN is assumed.
SITE_DOMAIN=
ACME_EMAIL=
PROXY_SUBNET=172.30.254.0/28
PROXY_ADDRESS=172.30.254.2
WEB_PROXY_ADDRESS=172.30.254.3

# Docker bounds. Increase only after measuring the workload on the target host.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# Opt-in: fresh Compose starts perform no live parsing or paid generation.
ENABLE_SCHEDULED_IMPORT=false
ENABLE_SCHEDULED_KGD=false
# Independent bounded source stages; failed records wait before re-entering the queue.
BACKGROUND_INTERVAL_SECONDS=60
BACKGROUND_COMPANY_BATCH=10
BACKGROUND_CONTRACT_BATCH=25
BACKGROUND_KGD_BATCH=10
BACKGROUND_PROFILE_SECONDS=120
BACKGROUND_KGD_SECONDS=300
BACKGROUND_REFRESH_DAYS=7
ENABLE_BACKGROUND_AI=false
BACKGROUND_AI_BATCH=2
BACKGROUND_ENRICHMENT_HIGH_WATER=100
BACKGROUND_MAX_REQUESTS=120
BACKGROUND_RETRY_SECONDS=21600
BACKGROUND_SOURCE_COOLDOWN_SECONDS=3600
# Shared ingestion: lease fencing, successful observation cache, seconds between host requests.
INGESTION_LEASE_SECONDS=900
INGESTION_SOURCE_CACHE_SECONDS=900
INGESTION_REQUEST_INTERVAL=1.5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-8b:free
GOSZAKUP_TOKEN=

# Saved explanations work with templates; generation requires an explicit staff job.
# Free local option: AI_PROVIDER=ollama, AI_MODEL=qwen3:4b.
# Native Ollama base: http://127.0.0.1:11434 for local Python.
# Compose calling Windows Ollama: http://host.docker.internal:11434.
AI_PROVIDER=template
AI_MODEL=
# Set a version/digest when updating a floating model alias to invalidate text reuse.
AI_MODEL_REVISION=
AI_BASE_URL=
# Native provider default; Docker uses DOCKER_OLLAMA_BASE_URL independently.
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
DOCKER_OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
AI_API_KEY=
# For optional paid APIs, set provider/model/key and explicitly enable this flag.
AI_ALLOW_PAID=false
# Experimental model scores are retained for evaluation, never published as risk.
AI_EXPERIMENTAL_SCORING=false
AI_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_INPUT_CHARS=8000
AI_MAX_FINDINGS=12
AI_CONTEXT_TOKENS=4096

# KGD checks are manual and disabled until official access is granted.
ENABLE_KGD_CHECKS=false
# X-Portal-Token request header; use the explicitly issued portal credential.
KGD_PORTAL_TOKEN=
# Private JSON map: selected company BIN -> personalAccountToken request parameter.
# Scope is restricted locally; the issuing service must confirm actual entitlement.
# Dotenv syntax: '{"YOUR_COMPANY_BIN":"replace-with-account-token"}'
# Do not use one account token for arbitrary companies; see docs/PHASE3.md.
KGD_ACCOUNT_TOKENS_JSON={}
# UL/UL_NR: legal entities. IP: explicit entrepreneur registration only; debt scope is unverified.
KGD_TAXPAYER_TYPE=UL
KGD_HTTP_TIMEOUT=30
KGD_SOURCE_CACHE_SECONDS=900
KGD_RESULT_MAX_AGE_DAYS=7
