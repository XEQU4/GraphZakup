# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-generated-secret
DB_PASSWORD=replace-with-your-own-database-password
DB_NAME=suppliergraph
DB_USER=suppliergraph
# DB_HOST/DB_PORT are for local Python; Compose always uses db:5432.
DB_HOST=localhost
DB_PORT=5432
CELERY_BROKER_URL=redis://localhost:6379/0

DJANGO_DEBUG=false
# Local Python file logs; Compose always sends logs only to stdout/stderr.
GPG_LOG_TO_FILES=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
PORT=8000

# Local HTTP. Enable secure cookies and redirect with a trusted HTTPS proxy.
TRUST_PROXY_SSL_HEADER=false
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Opt-in: fresh Compose starts perform no live parsing or paid generation.
ENABLE_SCHEDULED_IMPORT=false
# Shared ingestion: lease fencing, successful observation cache, seconds between host requests.
INGESTION_LEASE_SECONDS=900
INGESTION_SOURCE_CACHE_SECONDS=900
INGESTION_REQUEST_INTERVAL=1.5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-8b:free
GOSZAKUP_TOKEN=

# KGD checks are manual and disabled until official access is granted.
ENABLE_KGD_CHECKS=false
# X-Portal-Token request header; use the explicitly issued portal credential.
KGD_PORTAL_TOKEN=
# Private JSON map: selected company BIN -> personalAccountToken request parameter.
# Scope is restricted locally; the issuing service must confirm actual entitlement.
# Dotenv syntax: '{"YOUR_COMPANY_BIN":"replace-with-account-token"}'
# Do not use one account token for arbitrary companies; see docs/PHASE3.md.
KGD_ACCOUNT_TOKENS_JSON={}
KGD_TAXPAYER_TYPE=UL
KGD_HTTP_TIMEOUT=30
KGD_SOURCE_CACHE_SECONDS=900
KGD_RESULT_MAX_AGE_DAYS=7
